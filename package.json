{
  "name": "harness-deck",
  "version": "1.0.0",
  "private": true,
  "description": "Harness-Deck: Human-in-the-loop multi-agent collaboration protocol (HDP v1) and modular Skill + MCP bundle.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "pnpm -r --stream build",
    "test": "pnpm -r --stream test",
    "typecheck": "pnpm -r --stream typecheck",
    "clean": "pnpm -r --stream clean",
    "deck": "node --no-warnings packages/cli/dist/index.js",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "pack:bundle": "node scripts/pack-bundle.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
