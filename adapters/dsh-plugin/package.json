{
  "name": "@harness-deck/dsh-plugin",
  "version": "1.0.0",
  "type": "module",
  "description": "First reference native adapter for DeepSeek Harness (dsh / Cordis). Optional — core Harness-Deck remains 100% tool-neutral.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"console.log('dsh-plugin ready')\"",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@harness-deck/dispatcher": "workspace:*",
    "@harness-deck/mailroom": "workspace:*",
    "@harness-deck/protocol": "workspace:*"
  }
}
