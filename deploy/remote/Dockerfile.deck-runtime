FROM node:22-alpine

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY . /app

# Use npmmirror fallback if official npm registry is unreachable inside China VPS
RUN npm config set fetch-retries 3 && \
    if [ -d packages/cli/dist ]; then \
      pnpm install --prod --no-frozen-lockfile || \
      pnpm install --prod --no-frozen-lockfile --registry=https://registry.npmmirror.com; \
    else \
      (pnpm install --no-frozen-lockfile || pnpm install --no-frozen-lockfile --registry=https://registry.npmmirror.com) && \
      pnpm build; \
    fi

ENV NODE_ENV=production
EXPOSE 8787
CMD ["node", "--no-warnings", "packages/cli/dist/index.js", "relay"]
