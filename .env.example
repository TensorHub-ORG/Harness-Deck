# ==============================================================================
# Harness-Deck Environment Template (Copied to .env by `deck init` or Onboarding)
# NEVER commit your populated .env file!
# ==============================================================================

# --- Mailroom Connection ---
# Local single-machine mode (zero server):  file://./.deck/mailroom
# Cross-machine remote VPS relay mode:      http://<vps-host>:8787
DECK_ENDPOINT=file://./.deck/mailroom

# --- Scoped Agent Tokens (Generated automatically by `deck init`) ---
DECK_TOKEN_BOSS=
DECK_TOKEN_KUMI_O1=
DECK_TOKEN_KUMI_K1=
DECK_TOKEN_DISPATCHER=
DECK_TOKEN_ENGINEER=

# --- Relay Server (Only needed for cross-machine VPS deployment) ---
DECK_RELAY_HOST=0.0.0.0
DECK_RELAY_PORT=8787
DECK_RELAY_ADMIN_TOKEN=

# --- QQ / NapCat / Qmmi Integration ---
# Boss QQ numbers (T0, comma-separated)
DECK_BOSS_QQ_LIST=
# Allowed TensorHub community group IDs for K1 (T3, comma-separated)
DECK_COMMUNITY_GROUP_LIST=

# NapCat OneBot v11 WebSocket (O1 Secretary instance)
NAPCAT_O1_WS_URL=ws://127.0.0.1:3001
NAPCAT_O1_TOKEN=
NAPCAT_O1_WEBUI_PORT=6099

# NapCat OneBot v11 WebSocket (K1 Community instance - strongly recommended separate QQ!)
NAPCAT_K1_WS_URL=ws://127.0.0.1:3002
NAPCAT_K1_TOKEN=
NAPCAT_K1_WEBUI_PORT=6100

# Optional OpenAI-compatible LLM Brain for QQ Agent (Coomi O1 / K1 natural chat & tool calling)
DECK_QQ_LLM_BASE_URL=
DECK_QQ_LLM_API_KEY=
DECK_QQ_LLM_MODEL=
DECK_QQ_PERSONA_FILE=deploy/presets/coomi-o1-persona.txt

# Optional Qmmi webhook/HTTP bridge URL if delegating AI replies to Qmmi runtime
QMMI_O1_API_URL=
QMMI_K1_API_URL=

# --- Workstation Safety ---
DECK_WORKSTATION_CONFIG=.deck/workstation.yaml
DECK_AUDIT_DIR=.deck/audit
DECK_ARTIFACT_TTL_HOURS=168
